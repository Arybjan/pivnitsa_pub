# Подключение к PostgreSQL и Redis (для локального запуска без Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/auth_db
REDIS_URL=redis://localhost:6380/0

# JWT: ОДИН И ТОТ ЖЕ секрет у Auth, Booking, Payment, Event и Notification (минимум 32 символа)
JWT_SECRET=change-me-shared-with-other-services-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# dev | test | production
ENVIRONMENT=dev

# SMS: console — код печатается в лог; notification — отправка через Notification Service
SMS_PROVIDER=console
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Только для разработки фронтенда: вернуть OTP-код в ответе /otp/send (в production игнорируется)
OTP_EXPOSE_IN_RESPONSE=true
