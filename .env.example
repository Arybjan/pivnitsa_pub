# Общий секрет JWT для всех сервисов (минимум 32 символа)
JWT_SECRET=local-dev-shared-jwt-secret-change-me-32+

# Пути к сервисам и фронтенду (относительно корня репозитория)
AUTH_DIR=./backend/auth
EVENT_DIR=./backend/event
VENUE_DIR=./backend/venue
BOOKING_DIR=./backend/booking
PAYMENT_DIR=./backend/payment
NOTIFICATION_DIR=./backend/notification
ADMIN_FRONTEND_DIR=./admin
FRONTEND_DIR=./frontend

# --- Настоящие SMS (по умолчанию выключены: код виден в логе и на странице входа) ---
# Чтобы SMS приходили на телефоны:
#   SMS_PROVIDER=notification
#   OTP_EXPOSE_IN_RESPONSE=false   # иначе код виден на странице - любой зарегистрирует чужой номер
#   NIKITA_TEST_MODE=false
#   NIKITA_LOGIN / NIKITA_PASSWORD / NIKITA_SENDER - из личного кабинета smspro.nikita.kg
SMS_PROVIDER=console
OTP_EXPOSE_IN_RESPONSE=true
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=
NIKITA_TEST_MODE=true
