# База данных (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/event_db

# Redis
REDIS_URL=redis://localhost:6380/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# JWT секрет (сгенерируйте свой)
JWT_SECRET=your-super-secret-jwt-key-here-change-it

# URL сервиса авторизации
AUTH_SERVICE_URL=http://localhost:8001

# Host ports for the standalone Event stack
EVENT_SERVICE_PORT=8002
EVENT_POSTGRES_PORT=5433
EVENT_REDIS_PORT=6380
EVENT_RABBITMQ_PORT=5673
EVENT_RABBITMQ_MANAGEMENT_PORT=15673
