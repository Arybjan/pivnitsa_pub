PROJECT_NAME=Payment Service
PORT=8004
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/payment_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=events_exchange

# Booking Service: откуда брать бронь для проверки и расчёта суммы
BOOKING_SERVICE_URL=http://localhost:8002
DEPOSIT_PER_GUEST=1000.00
CURRENCY=KGS

# Payment Gateway (Stripe / Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder_for_dev
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_for_dev
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_dev
PAYMENT_GATEWAY_ENV=sandbox

# JWT: тот же секрет, что у Auth и Booking Service (обязательно)
JWT_SECRET=change-me-shared-with-other-services
JWT_ALGORITHM=HS256

CORS_ORIGINS=*
